# ─── Firebase (analytics only on the client; auth + Firestore are server-side) ─
# Browser uses these for analytics. Auth and Firestore now flow through
# /api/auth/* and /api/users/* — the Firebase Admin SDK on the server.
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# ─── Firebase Admin SDK (server-side Firestore + auth user lookup) ─────────────
# Generate via Firebase Console → Project Settings → Service Accounts →
# Generate New Private Key. Copy the three fields out of the resulting JSON.
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@your_project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ─── Session signing ───────────────────────────────────────────────────────────
# Used to sign the cm_session JWT cookie. Rotate by replacing — invalidates
# every existing session. Generate with: openssl rand -base64 48
SESSION_SECRET=replace_with_random_48_byte_base64_value

# ─── Google OAuth (server-routed; bypasses *.firebaseapp.com) ──────────────────
# Create at console.cloud.google.com → APIs & Services → Credentials.
# Authorized redirect URIs must include:
#   https://your-domain.com/api/auth/google/callback
#   http://localhost:3000/api/auth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ─── Resend (transactional email — password reset) ─────────────────────────────
# Sign up at resend.com (free tier: 3000 emails/month). Verify your sending
# domain in Resend's dashboard before RESEND_FROM_EMAIL will deliver to anyone
# but the account owner.
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@your-domain.com

# ─── Chess Masti Internship Program (CMIP) ─────────────────────────────────────
# Where new internship applications are emailed. Both applicant and admin
# emails go through Resend (RESEND_API_KEY above). If CMIP_ADMIN_EMAIL is
# unset, the admin notification is skipped with a server log.
CMIP_FROM_EMAIL=noreply@chessmasti.com
CMIP_ADMIN_EMAIL=applications@chessmasti.com
CMIP_CONTACT_EMAIL=applications@chessmasti.com

# ─── Auth enforcement on legacy Bearer-token routes ────────────────────────────
# Leave false unless you also need to gate /api/enhanced-analysis behind a
# Bearer token. The new cookie-session auth on /api/auth/* and /api/users/*
# is independent of this flag.
AUTH_ENFORCED=false

# ─── App URLs ──────────────────────────────────────────────────────────────────
# NEXT_PUBLIC_APP_URL: where the app is served. Used for OAuth redirect_uri
# and absolute-URL construction. MUST be the public origin in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Used for SEO and canonical links (independent of NEXT_PUBLIC_APP_URL).
NEXT_PUBLIC_SITE_URL=https://chessmasti.com

# ─── Anthropic / OpenAI ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1

# ─── Maia-2 Microservice ───────────────────────────────────────────────────────
# Deploy maia-service/ to Railway/Fly.io/Render, then set this URL.
# Local dev: run `uvicorn maia_server:app --port 8000` in maia-service/
MAIA_API_URL=http://localhost:8000

# ─── Lichess OAuth (already in place) ──────────────────────────────────────────
# Lichess public OAuth uses PKCE without pre-registration; the client ID
# is just a stable identifier shown to users in the consent prompt.
NEXT_PUBLIC_LICHESS_CLIENT_ID=chessmasti-live

# ─── Misc ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_MAINTENANCE_MODE=false

# ─── Supabase (CMIP intern feedback portal) ────────────────────────────────────
# Server-side only. SERVICE_ROLE_KEY bypasses Row-Level Security; never expose to browser.
# Provision project at supabase.com → org "Chess Masti" → new project.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_REPLACE_ME

# CMIP-1.D: personal email of the human admin who reaches /admin/intern-data
# Distinct from CMIP_ADMIN_EMAIL (which is the role-mailbox for application emails).
CMIP_DASHBOARD_ADMIN_EMAIL=you@example.com

# ─── Tracking / telemetry (TRK-0) ──────────────────────────────────────────────
# SEPARATE Supabase project from the CMIP one above (different URL + key pair).
# Server-side only; service-role key bypasses RLS, never expose to browser.
# See supabase-tracking/README.md and TRACKING_PLAN.md.
TRACKING_SUPABASE_URL=https://YOUR_TRACKING_PROJECT_REF.supabase.co
TRACKING_SUPABASE_SERVICE_ROLE_KEY=sb_secret_REPLACE_ME
# Master kill switch. Every tracking write no-ops unless this is truthy
# ("true"/"1"/"yes"). Keep OFF in prod until the privacy policy + consent
# banner are live (TRACKING_PLAN.md §1). Mind the trailing-\n gotcha — parser trims.
TRACKING_ENABLED=false
# Salt for SHA-256(ip + salt). Raw IPs are never stored. Generate: openssl rand -base64 32
TRACKING_IP_SALT=REPLACE_ME

# ─── Stripe (pricing pivot — $0.99/mo premium, 7-day trial) ────────────────────
# Full setup steps: docs/STRIPE_GO_LIVE.md. Use sk_test_/pk_test_ until launch.
#  1. Create a Product "Chess Masti Premium" with a recurring $0.99/mo price →
#     copy its price_… id into STRIPE_PRICE_ID.
#  2. Secret + publishable keys from Developers → API keys.
#  3. Add a webhook endpoint …/api/stripe/webhook → copy its signing secret.
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
STRIPE_PRICE_ID=price_REPLACE_ME
# Master switch for freemium ENFORCEMENT. OFF (default) ⇒ every user is treated
# as premium and nothing is gated — safe to merge dark. Flip to "true" only
# after the Stripe vars above are live. Mind the trailing-\n gotcha (trimmed).
FREEMIUM_ENABLED=false
