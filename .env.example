# ─── Firebase (analytics only on the client; auth + Firestore are server-side) ─
# Browser uses these for analytics. Auth and Firestore now flow through
# /api/auth/* and /api/users/* — the Firebase Admin SDK on the server.
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# ─── Firebase Admin SDK (server-side Firestore + auth user lookup) ─────────────
# Generate via Firebase Console → Project Settings → Service Accounts →
# Generate New Private Key. Copy the three fields out of the resulting JSON.
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@your_project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ─── Session signing ───────────────────────────────────────────────────────────
# Used to sign the cm_session JWT cookie. Rotate by replacing — invalidates
# every existing session. Generate with: openssl rand -base64 48
SESSION_SECRET=replace_with_random_48_byte_base64_value

# ─── Google OAuth (server-routed; bypasses *.firebaseapp.com) ──────────────────
# Create at console.cloud.google.com → APIs & Services → Credentials.
# Authorized redirect URIs must include:
#   https://your-domain.com/api/auth/google/callback
#   http://localhost:3000/api/auth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ─── Resend (transactional email — password reset) ─────────────────────────────
# Sign up at resend.com (free tier: 3000 emails/month). Verify your sending
# domain in Resend's dashboard before RESEND_FROM_EMAIL will deliver to anyone
# but the account owner.
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@your-domain.com

# ─── Auth enforcement on legacy Bearer-token routes ────────────────────────────
# Leave false unless you also need to gate /api/enhanced-analysis behind a
# Bearer token. The new cookie-session auth on /api/auth/* and /api/users/*
# is independent of this flag.
AUTH_ENFORCED=false

# ─── App URLs ──────────────────────────────────────────────────────────────────
# NEXT_PUBLIC_APP_URL: where the app is served. Used for OAuth redirect_uri
# and absolute-URL construction. MUST be the public origin in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Used for SEO and canonical links (independent of NEXT_PUBLIC_APP_URL).
NEXT_PUBLIC_SITE_URL=https://chessmasti.com

# ─── Anthropic / OpenAI ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1

# ─── Maia-2 Microservice ───────────────────────────────────────────────────────
# Deploy maia-service/ to Railway/Fly.io/Render, then set this URL.
# Local dev: run `uvicorn maia_server:app --port 8000` in maia-service/
MAIA_API_URL=http://localhost:8000

# ─── Lichess OAuth (already in place) ──────────────────────────────────────────
# Lichess public OAuth uses PKCE without pre-registration; the client ID
# is just a stable identifier shown to users in the consent prompt.
NEXT_PUBLIC_LICHESS_CLIENT_ID=chessmasti-live

# ─── Misc ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_MAINTENANCE_MODE=false
