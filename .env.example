# Firebase Configuration
# Create a Firebase project at https://console.firebase.google.com
# Then enable Authentication (Google provider) and Firestore Database
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app

# Anthropic API Key
# Get your key from https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI API Key (optional - for enhanced analysis)
# Get your key from https://platform.openai.com
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Maia-2 Microservice URL
# Deploy the maia-service/ directory to Railway/Fly.io/Render, then set this URL.
# For local development: run `uvicorn maia_server:app --port 8000` in maia-service/
MAIA_API_URL=http://localhost:8000

# Site URL (used for SEO and canonical links)
NEXT_PUBLIC_SITE_URL=https://chessmasti.com

# Optional: Set to "true" to enable maintenance mode
NEXT_PUBLIC_MAINTENANCE_MODE=false
