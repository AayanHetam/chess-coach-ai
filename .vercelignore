# Exclude large directories and files from Vercel deployment
node_modules/
.git/
.next/
Chesskit/
/chess-coach-ai/
/data/
venv_gameknot/
*.zip
*.pgn
*.pb
*.pyc
*.csv
# Puzzle Coach feed needs the 100k Lichess puzzle CSV shipped as a
# static asset. .vercelignore's *.csv glob was stripping it from every
# deploy regardless of path (data/, src/data/, public/data/), causing
# /api/puzzle-feed to 503 with "Couldn't load puzzles" on /preview/puzzles.
# Negation re-includes the file. Other CSVs (training data dumps, etc.)
# stay excluded.
!public/data/lichess_puzzles_100k.csv
*.log
*.tar.gz
__pycache__/
*.md
datasets/
lichess_elite_pgns/
maia-weights/
# Broad scripts/ exclude removed 2026-05-23 — Stage C route-side cache
# fallback (src/lib/mastermind/stageCcacheFallback.ts) imports
# scripts/synthetic-tester/fixtures/user_history_cache/*.json at build
# time. Only scripts/data-pipeline/ is large enough (33 MB) to warrant
# its own exclude; the rest of scripts/ (~2 MB) ships to Vercel.
scripts/data-pipeline/
maia-service/
book_database.json
test_results.json
# Test scripts in root
test-*.mjs
check-*.mjs
query-*.mjs
verify-*.mjs
write-*.mjs
add-indexes.mjs
puzzle_load*.log
