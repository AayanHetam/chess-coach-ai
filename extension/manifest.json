{
  "manifest_version": 3,
  "name": "Chess Masti: AI Game Review for Lichess & Chess.com",
  "version": "1.0.1",
  "description": "Free AI chess analysis in one click. Stockfish + an AI coach review your Lichess and Chess.com games and explain your mistakes.",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://lichess.org/*"],
      "js": ["content/shared.js", "content/lichess.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.chess.com/*"],
      "js": ["content/shared.js", "content/chesscom.js"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": ["https://lichess.org/*"]
}
