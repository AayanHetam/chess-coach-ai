{
  "manifest_version": 3,
  "name": "Analyze with Chess Masti",
  "version": "1.0.0",
  "description": "Adds a one-click Analyze button to Lichess + Chess.com games. Opens chessmasti.com with the PGN auto-loaded for AI coaching.",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://lichess.org/*"],
      "js": ["content/shared.js", "content/lichess.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.chess.com/*"],
      "js": ["content/shared.js", "content/chesscom.js"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": ["https://lichess.org/*"]
}
