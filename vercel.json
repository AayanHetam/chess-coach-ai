{
  "buildCommand": "npm run build",
  "framework": "nextjs",
  "functions": {
    "src/app/api/**/*.ts": {
      "maxDuration": 60
    }
  },
  "installCommand": "npm install",
  "ignoreCommand": "exit 1",
  "build": {
    "env": {
      "NEXT_PUBLIC_SITE_URL": "https://chessmasti.com",
      "SKIP_ENV_VALIDATION": "true"
    }
  },
  "crons": [
    {
      "path": "/api/keep-maia-alive",
      "schedule": "0 0 * * *"
    }
  ]
}


